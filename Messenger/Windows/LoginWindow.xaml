<Window x:Class="Messenger.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceHub Messenger" Height="500" Width="380"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="40,50" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="VoiceHub" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Мессенджер" FontSize="14" Foreground="{StaticResource Txt2Brush}" HorizontalAlignment="Center" Margin="0,4,0,30"/>

            <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}" Margin="0,0,0,12" Width="280" HorizontalAlignment="Center"/>
            <PasswordBox x:Name="PassBox" Background="#0f0f1a" Foreground="{StaticResource TxtBrush}" BorderBrush="#2a2a3e" BorderThickness="1" Padding="12,10" FontSize="14" Margin="0,0,0,12" Width="280" HorizontalAlignment="Center"/>
            <TextBox x:Name="NickBox" Style="{StaticResource InputBox}" Margin="0,0,0,16" Width="280" HorizontalAlignment="Center" Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>

            <Button Content="Войти" Style="{StaticResource AccentBtn}" Width="280" HorizontalAlignment="Center" Margin="0,0,0,8" Click="Login_Click"/>
            <Button x:Name="RegBtn" Content="Нет аккаунта? Регистрация" Background="Transparent" Foreground="{StaticResource Txt2Brush}" BorderThickness="0" FontSize="13" Cursor="Hand" Click="Reg_Click" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
